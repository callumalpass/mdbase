{
  "name": "@callumalpass/mdbase",
  "version": "0.2.2",
  "description": "TypeScript implementation of the mdbase specification",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callumalpass/mdbase.git"
  },
  "bugs": {
    "url": "https://github.com/callumalpass/mdbase/issues"
  },
  "homepage": "https://github.com/callumalpass/mdbase#readme",
  "bin": {
    "mdb-profile": "dist/bin/mdb-profile.js"
  },
  "keywords": [
    "markdown",
    "sqlite",
    "obsidian",
    "knowledge-base",
    "frontmatter",
    "mdbase"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run --reporter=verbose test/conformance.test.ts",
    "profile": "npm run build && node dist/bin/mdb-profile.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.0",
    "sql.js": "^1.12.0",
    "ulid": "^2.3.0",
    "uuid": "^10.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
